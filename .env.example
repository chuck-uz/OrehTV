# Копия → .env (600). Значения — через терминал, не через чат.
# Пароль админки и ключ TMDB задаёт мастер первого запуска (http://<сервер>/setup) — в .env они не нужны.
# (Старая схема: ADMIN_HASH и TMDB_KEY здесь — при первом старте переносятся в data/admin.json и secrets/tmdb.key.)
# Порт Caddy на хосте: 81 на время переезда рядом со старым стеком, потом 80
PORT=81
# apikey JacRed, если задан в jacred/config/init.yaml (иначе пусто)
JACRED_APIKEY=
# Образ API: по умолчанию публичный ghcr.io/chuck-uz/tvoreh-api:latest; у нас — домашний реестр
#API_IMAGE=git.home.oresh.in/chuck-uz/tvoreh-api:latest
# Автопоиск с ТВ (контейнер discovery в сети хоста) — только Linux
COMPOSE_PROFILES=linux
# Канал обновлений приложения с витрины GitHub: release (друзья) или prerelease (наш сервер — проверяем первыми)
UPDATES_CHANNEL=release
# Имя сервера в автопоиске на ТВ и часовой пояс планировщика
SERVER_NAME=TVOREH
TZ=UTC
